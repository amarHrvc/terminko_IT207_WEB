{
    "name": "amarhrvc/terminko",
    "description": "Booking and appointment scheduling platform designed for service-based businesses",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "amar.hajrovic",
            "email": "amar.hajrovic@stu.ibu.edu.ba"
        }
    ],
    "require": {
        "php": "^8.4",
        "flightphp/core": "^3.15"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.12",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
